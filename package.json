{
  "name": "lattice-policy",
  "version": "0.2.3",
  "description": "Open-source framework for access-based insurance policy administration systems.",
  "private": true,
  "license": "Apache-2.0",
  "author": "Kishor Kumar Jakkula",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kishorjakkula/LatticePolicy.git"
  },
  "bugs": {
    "url": "https://github.com/kishorjakkula/LatticePolicy/issues"
  },
  "homepage": "https://github.com/kishorjakkula/LatticePolicy#readme",
  "keywords": [
    "insurance",
    "policy-administration",
    "multi-tenant",
    "framework"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "frontend",
    "server"
  ],
  "scripts": {
    "test:document-learning": "node --test services/document-learning/*.test.mjs",
    "test:document-training": "python3 -m unittest discover -s services/document-learning/training -p 'test_*.py'",
    "test:document-deployment": "node --test deploy/document-processing/*.test.mjs deploy/release-signer/*.test.mjs",
    "document:learning": "node services/document-learning/cli.mjs",
    "test:document-processor": "node --test services/document-processor/*.test.mjs",
    "test:release-signer": "node --test services/release-signer/*.test.mjs",
    "flow": "node scripts/delivery/flow.mjs",
    "agents:sync": "node scripts/delivery/sync-agents.mjs",
    "delivery:check": "node scripts/delivery/check.mjs",
    "knowledge:report": "node scripts/delivery/knowledge-report.mjs",
    "test:delivery": "node --test scripts/delivery/*.test.mjs",
    "dev:server": "npm run dev --workspace=server",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:packages": "npm run build --workspace=@lattice-policy/rules",
    "test:packages": "npm run test --workspace=@lattice-policy/rules",
    "build:frontend": "npm run build --workspace=frontend",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:frontend && npm run build:server",
    "test:frontend": "npm run test --workspace=frontend",
    "test:server": "npm run test --workspace=server",
    "test:contracts": "npm run test:contracts --workspace=server",
    "test:coverage": "npm run test:coverage --workspace=frontend && npm run test:coverage --workspace=server",
    "test:local": "npm run test:document-processor && npm run test:release-signer && npm run test:document-learning && npm run test:packages && npm run test:frontend && npm run test:server",
    "test": "sh scripts/test.sh",
    "test:docker": "sh scripts/test-docker.sh",
    "test:integration": "sh scripts/test-integration.sh",
    "test:e2e": "playwright test",
    "test:e2e:docker": "sh scripts/test-e2e-docker.sh",
    "test:e2e:isolated": "sh scripts/test-e2e-isolated.sh",
    "test:e2e:report": "node scripts/summarize-playwright.mjs",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "deploy:local": "sh scripts/deploy-local.sh",
    "security:audit": "node scripts/check-npm-audit.mjs",
    "sync:github-roadmap": "node scripts/sync-github-roadmap.mjs",
    "check:import-templates": "node scripts/check-import-templates.mjs",
    "check:architecture": "node --test scripts/check-module-boundaries.test.mjs && node scripts/check-module-boundaries.mjs",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test:carrier-stack": "node --test scripts/carrier-stack.test.mjs scripts/pilot-lib.test.mjs",
    "pilot:up": "node scripts/pilot-up.mjs",
    "pilot:check": "node scripts/pilot-check.mjs",
    "pilot:browser": "node scripts/pilot-browser.mjs",
    "pilot:drill": "node scripts/pilot-drill.mjs",
    "pilot:monitor": "node scripts/pilot-monitor.mjs",
    "pilot:rebrand-documents": "node scripts/pilot-rebrand-documents.mjs",
    "pilot:handoff": "node scripts/pilot-handoff.mjs"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.64.7",
    "@rollup/rollup-linux-arm64-musl": "4.64.7",
    "@rollup/rollup-linux-x64-gnu": "4.64.7"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "exceljs@4.4.0": {
      "uuid": "11.1.1"
    },
    "basic-ftp": "6.2.2"
  },
  "devDependencies": {
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "4.10.38"
  }
}
