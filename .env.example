# Copy this file to .env and fill in real values. Never commit .env.

# Database
DB_PASSWORD=yourStrongPassword
DB_USER=lattice_policy
DB_NAME=lattice_policy

# Server secrets
JWT_SECRET=change-me-please-use-a-long-random-string
CUSTOMER_DATA_KEY=change-me-please-use-a-separate-long-random-string
MFA_TOKEN_SECRET=change-me-please-use-another-long-random-string

# Demo/private access controls
# Use DEPLOYMENT_ENV=test and invite_only for cloud validation where only selected users should log in.
DEPLOYMENT_ENV=local
DEMO_ACCESS_MODE=invite_only
DEMO_ALLOWED_EMAILS=demo.user@example.com
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Optional: Sentry DSN for error tracking
SENTRY_DSN=
VITE_SENTRY_DSN=

# Optional: override API base URL (used by docker-compose build args)
VITE_API_BASE_URL=http://localhost:3300
