# Use a separate env file per carrier. Do not commit real secrets.
DOCUMENT_PROCESSOR_TOKEN=
CARRIER_TENANT_ID=
RELEASE_ENVIRONMENT=validation
LLM_RELEASE_PUBLIC_KEY_FILE=/absolute/carrier-owned/release-public.pem
# Lifetime policy for existing signed approvedAt timestamps; no unlimited mode.
LLM_RELEASE_MAX_AGE_SECONDS=604800
# Required host LLM_RELEASE_REVOCATION_DIR must exist; Compose will not create it.
# It must contain revocations.json (or the configured file name), initially:
# {"schemaVersion":1,"releaseIds":[]}
LLM_RELEASE_REVOCATION_DIR=/absolute/carrier-owned/release-policy
# Container path, not the host path. Host-side operator runs must instead use
# /absolute/carrier-owned/release-policy/revocations.json for this variable.
LLM_RELEASE_REVOCATION_FILE=/release-policy/revocations.json
MODEL_ARTIFACT_SHA256=
# Pin to an approved version/digest; the service never downloads model weights.
OLLAMA_IMAGE=
MODEL_NAME=
LOCAL_MODELS_DIR=/absolute/carrier-owned/ollama-models
EXTRACTION_PROFILES_DIR=/absolute/carrier-owned/extraction-profiles
DOCUMENT_NETWORK=carrier-demo-documents-private
MODEL_MEMORY_LIMIT=8g
