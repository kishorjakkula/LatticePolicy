# Per-carrier settings for deploy/carrier-stack. `stack.sh init <tenant-id>
# <version>` writes a carrier.env from this template with generated secrets.
# Keep carrier.env out of source control.

# --- Carrier -----------------------------------------------------------------
# Lowercase slug; becomes the tenant id and part of the Compose project name.
CARRIER_TENANT_ID=
CARRIER_NAME=

# --- Release -----------------------------------------------------------------
# Release tag to run, for example v0.3.0. `stack.sh upgrade` changes this.
LATTICE_VERSION=
LATTICE_API_IMAGE=ghcr.io/kishorjakkula/latticepolicy-api
LATTICE_FRONTEND_IMAGE=ghcr.io/kishorjakkula/latticepolicy-frontend
# Set to 0 when images are pre-loaded on the host (air-gapped installs).
LATTICE_PULL=1

# --- Carrier pack ------------------------------------------------------------
# Absolute path on this host to the carrier's pack (its products, fields, and
# overrides). Leave empty to run the framework's products unchanged.
CARRIER_PACK_PATH=

# --- Addresses ---------------------------------------------------------------
# Public HTTPS origin of the API as browsers reach it (no trailing slash).
PUBLIC_API_URL=
# Public HTTPS origin(s) of the UI, comma-separated.
ALLOWED_ORIGINS=
API_PORT=3300
UI_PORT=8080
# Bind locally behind an HTTPS proxy. Set another interface explicitly when needed.
HOST_BIND=127.0.0.1

# --- Runtime -----------------------------------------------------------------
# production | staging. Use `local` only for a trial on one machine over HTTP.
DEPLOYMENT_ENV=production
# Enforce tenant row-level security in the database. Leave on.
TENANT_RLS_ENFORCED=1
SENTRY_DSN=

# --- Submission intake --------------------------------------------------------
# Who reads broker submissions: builtin (label reader, nothing leaves this
# stack) or private (separately deployed local inference). External providers
# are blocked by default. A person approves every value either way.
INTAKE_AI_PROVIDER=builtin
INTAKE_DATA_BOUNDARY=private
DOCUMENT_PROCESSOR_URL=
DOCUMENT_PROCESSOR_TOKEN=
DOCUMENT_EXTRACTION_PROFILE=submission
# Release governance. The private key lives only in the separate release
# signer (deploy/release-signer); the API refuses an inline key in managed
# deployments. Apply deploy/release-signer/application.signer.yml to the API.
LLM_RELEASE_SIGNER_TOKEN=
# Public key (PEM, \n-escaped) the API checks every signature against.
LLM_RELEASE_PUBLIC_KEY=
# Release automation must use a scoped service credential (issued on the LLM
# Releases page); session logins are refused in managed deployments.
# Email is optional. Only literal true enables registration notices/delivery.
LLM_EMAIL_ENABLED=false
# Required only when email is enabled; use the HTTPS administration origin.
LLM_REVIEW_UI_URL=
# Approved carrier SMTP relay. TLS is mandatory; no document attachments.
LLM_SMTP_HOST=
LLM_SMTP_PORT=587
LLM_SMTP_FROM=
LLM_SMTP_USER=
LLM_SMTP_PASSWORD=
INTAKE_AI_MODEL=
INTAKE_AI_BASE_URL=
ANTHROPIC_API_KEY=

# --- Message delivery ---------------------------------------------------------
# How the dispatcher service delivers messages: webhook or kafka.
EVENT_TRANSPORT=webhook

# Webhook: where messages are posted. Empty writes them to the dispatcher's
# log instead.
ASYNC_PUSH_WEBHOOK_URL=
ASYNC_PUSH_AUTH_HEADER=

# Kafka: brokers as host:port, comma-separated. Messages go to one topic
# (KAFKA_TOPIC, default lattice.events), or to one topic per message type when
# KAFKA_TOPIC_PREFIX is set instead.
KAFKA_BROKERS=
KAFKA_TOPIC=
KAFKA_TOPIC_PREFIX=
KAFKA_CLIENT_ID=
KAFKA_SSL=
# plain, scram-sha-256, or scram-sha-512
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Database ----------------------------------------------------------------
DB_USER=lattice_policy
DB_NAME=lattice_policy
DB_PASSWORD=

# --- Secrets (generated by `stack.sh init`; each must be unique, 32+ chars) --
JWT_SECRET=
CUSTOMER_DATA_KEY=
PII_LOOKUP_KEY=
MFA_TOKEN_SECRET=
