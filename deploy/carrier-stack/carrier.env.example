# Per-carrier settings for deploy/carrier-stack. `stack.sh init <tenant-id>
# <version>` writes a carrier.env from this template with generated secrets.
# Keep carrier.env out of source control.

# --- Carrier -----------------------------------------------------------------
# Lowercase slug; becomes the tenant id and part of the Compose project name.
CARRIER_TENANT_ID=
CARRIER_NAME=

# --- Release -----------------------------------------------------------------
# Release tag to run, for example v0.3.0. `stack.sh upgrade` changes this.
LATTICE_VERSION=
LATTICE_API_IMAGE=ghcr.io/kishorjakkula/latticepolicy-api
LATTICE_FRONTEND_IMAGE=ghcr.io/kishorjakkula/latticepolicy-frontend
# Set to 0 when images are pre-loaded on the host (air-gapped installs).
LATTICE_PULL=1

# --- Carrier pack ------------------------------------------------------------
# Absolute path on this host to the carrier's pack (its products, fields, and
# overrides). Leave empty to run the framework's products unchanged.
CARRIER_PACK_PATH=

# --- Addresses ---------------------------------------------------------------
# Public HTTPS origin of the API as browsers reach it (no trailing slash).
PUBLIC_API_URL=
# Public HTTPS origin(s) of the UI, comma-separated.
ALLOWED_ORIGINS=
API_PORT=3300
UI_PORT=8080

# --- Runtime -----------------------------------------------------------------
# production | staging. Use `local` only for a trial on one machine over HTTP.
DEPLOYMENT_ENV=production
# Enforce tenant row-level security in the database. Leave on.
TENANT_RLS_ENFORCED=1
SENTRY_DSN=

# --- Message delivery ---------------------------------------------------------
# Where the dispatcher service posts outbox messages. Empty writes them to the
# dispatcher's log instead.
ASYNC_PUSH_WEBHOOK_URL=
ASYNC_PUSH_AUTH_HEADER=

# --- Database ----------------------------------------------------------------
DB_USER=lattice_policy
DB_NAME=lattice_policy
DB_PASSWORD=

# --- Secrets (generated by `stack.sh init`; each must be unique, 32+ chars) --
JWT_SECRET=
CUSTOMER_DATA_KEY=
PII_LOOKUP_KEY=
MFA_TOKEN_SECRET=
