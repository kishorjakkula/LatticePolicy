{
  "name": "lattice-policy-server",
  "version": "0.2.3",
  "description": "LatticePolicy API server.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:contracts": "vitest run src/__tests__/contracts.test.ts src/__tests__/openapi-contract.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:transactions": "node scripts/smoke-transactions.mjs",
    "migrate": "tsx src/migrate.ts",
    "validate:restore": "tsx scripts/validate-restored-db.ts",
    "rehash:pii": "tsx scripts/rehash-sensitive-lookups.ts"
  },
  "dependencies": {
    "@lattice-policy/types": "0.2.3",
    "@sentry/node": "^10.75.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^1.0.0-rc.5-169397b",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "proxy-addr": "^2.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^1.0.0-rc.5-5935859",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "form-data": "4.0.6"
  }
}
