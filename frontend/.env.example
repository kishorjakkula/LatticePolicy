VITE_API_BASE_URL=
VITE_USE_MOCK=1

# Production builds require VITE_USE_MOCK=0 and an absolute HTTPS VITE_API_BASE_URL.

# Optional: set on a single-carrier stack to the same value as the API's
# CARRIER_TENANT_ID. The UI then always addresses that carrier and the login
# page no longer asks for an organization.
VITE_CARRIER_TENANT_ID=
